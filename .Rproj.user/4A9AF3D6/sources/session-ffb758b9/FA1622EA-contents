```{r}
set.seed(1)
sim_data <- generate_data(M, pi1, alpha)
P_sim <- sim_data$P
Z_sim <- sim_data$Z

em_res <- run_EM_logscale(P_sim)
cat("函数估计 pi1_est:", em_res$pi1_est, "\n")
cat("函数估计 alpha_est:", em_res$alpha_est, "\n")

posterior_sim <- em_res$posterior
Z_est_sim <- assoc(posterior_sim, 0.1)

TP_sim <- sum(Z_sim == 1 & Z_est_sim == 1)
FP_sim <- sum(Z_sim == 0 & Z_est_sim == 1)
FN_sim <- sum(Z_sim == 1 & Z_est_sim == 0)

FDP_sim <- FP_sim / max(FP_sim + TP_sim, 1)
power_sim <- TP_sim / max(TP_sim + FN_sim, 1)

cat("函数计算 FDP:", FDP_sim, "\n")
cat("函数计算 Power:", power_sim, "\n")
```
1.8 进行多次模拟，统计实验结果
```{r}
n_sim <- 50
results <- data.frame(pi1_est = numeric(n_sim), 
                      alpha_est = numeric(n_sim),
                      FDP = numeric(n_sim), 
                      power = numeric(n_sim))

for (i in 1:n_sim) {
  data_i <- generate_data(M, pi1, alpha)
  em_i <- run_EM_logscale(data_i$P)
  Z_est_i <- assoc(em_i$posterior, 0.1)
  
  TP_i <- sum(data_i$Z == 1 & Z_est_i == 1)
  FP_i <- sum(data_i$Z == 0 & Z_est_i == 1)
  FN_i <- sum(data_i$Z == 1 & Z_est_i == 0)
  
  results$pi1_est[i] <- em_i$pi1_est
  results$alpha_est[i] <- em_i$alpha_est
  results$FDP[i] <- FP_i / max(FP_i + TP_i, 1)
  results$power[i] <- TP_i / max(TP_i + FN_i, 1)
}

par(mfrow = c(2, 2))
boxplot(results$pi1_est, main = expression(paste("Estimated ", pi[1])), ylab="Value")
abline(h=0.2, col="blue", lty=2)
boxplot(results$alpha_est, main = expression(paste("Estimated ", alpha)), ylab="Value")
abline(h=0.2, col="blue", lty=2)
boxplot(results$FDP, main = "FDP (Target = 0.1)", ylab="FDP")
abline(h=0.1, col="red", lty=2)
boxplot(results$power, main = "Power", ylab="Power")
```
