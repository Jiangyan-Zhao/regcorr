1.4 识别与疾病有关的SNP
基于潜变量的后验概率推断出哪些SNP与疾病有关（控制FDR）。
```{r}
assoc <- function(posterior, alpha_FDR){
  M          <- length(posterior)
  fdr        <- 1 - posterior
  rank.fdr   <- rank(fdr)
  sort.fdr   <- sort(fdr)
  cumsum.fdr <- cumsum(sort.fdr)
  sort.FDR   <- cumsum.fdr/seq(1, M, 1)
  FDR        <- sort.FDR[rank.fdr]
  
  Z_est <- rep(0, M)
  Z_est[which(FDR <= alpha_FDR)] <- 1
  return(Z_est)
}

A_final <- log(pi1_est) + log(alpha_est) + (alpha_est - 1) * logP
B_final <- rep(log(1 - pi1_est), length(logP))
max_AB_final <- pmax(A_final, B_final)
log_denom_final <- max_AB_final + log(exp(A_final - max_AB_final) + exp(B_final - max_AB_final))

posterior <- exp(A_final - log_denom_final)

alpha_FDR <- 0.1
Z_est <- assoc(posterior, alpha_FDR)
```
