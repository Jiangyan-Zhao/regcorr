1.6 将数据生成过程与EM算法写成函数形式
```{r}
generate_data <- function(M, pi1, alpha) {
  Z <- rbinom(M, 1, pi1)
  P <- rep(0, M)  
 P[Z == 0] <- runif(sum(Z == 0), 0, 1)
 P[Z == 1] <- rbeta(sum(Z == 1), alpha, 1)
  P[P <= 0] <- 1e-300
  return(list(P = P, Z = Z))
}

run_EM_logscale <- function(P, max_iter = 10000, tol = 1e-6) {
  logP <- log(P)
  pi1_est <- 0.5
  alpha_est <- 0.5
  
  A <- log(pi1_est) + log(alpha_est) + (alpha_est - 1) * logP
  B <- rep(log(1 - pi1_est), length(logP))
  max_AB <- pmax(A, B)
  log_denom <- max_AB + log(exp(A - max_AB) + exp(B - max_AB))
  ll <- sum(log_denom)
  
  for (iter in 1:max_iter) {
    A <- log(pi1_est) + log(alpha_est) + (alpha_est - 1) * logP
    B <- rep(log(1 - pi1_est), length(logP))
    max_AB <- pmax(A, B)
    log_denom <- max_AB + log(exp(A - max_AB) + exp(B - max_AB))
    
    gamma <- exp(A - log_denom)
    
    pi1_est_new <- mean(gamma)
    alpha_est_new <- -sum(gamma) / sum(gamma * logP)
    
    A_new <- log(pi1_est_new) + log(alpha_est_new) + (alpha_est_new - 1) * logP
    B_new <- rep(log(1 - pi1_est_new), length(logP))
    max_AB_new <- pmax(A_new, B_new)
    log_denom_new <- max_AB_new + log(exp(A_new - max_AB_new) + exp(B_new - max_AB_new))
    ll_new <- sum(log_denom_new)
    
    if (abs(ll_new - ll) < tol) {
      pi1_est <- pi1_est_new
      alpha_est <- alpha_est_new
      break
    }
    pi1_est <- pi1_est_new
    alpha_est <- alpha_est_new
    ll <- ll_new
  }
  
  A_final <- log(pi1_est) + log(alpha_est) + (alpha_est - 1) * logP
  B_final <- rep(log(1 - pi1_est), length(logP))
  max_AB_final <- pmax(A_final, B_final)
  posterior <- exp(A_final - (max_AB_final + log(exp(A_final - max_AB_final) + exp(B_final - max_AB_final))))
  
  return(list(pi1_est = pi1_est, alpha_est = alpha_est, posterior = posterior))
}
```
